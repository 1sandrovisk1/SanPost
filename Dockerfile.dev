# Node 22 (LTS) fixado no patch: 22.23.4 e a primeira versao com o security
# release de 21/10/2026 (CVE-2026-111497 — RCE no decoder Brotli, alcancavel
# antes da autenticacao porque o body-parser do Express 5 descomprime
# `Content-Encoding: br`; mais correcoes de dns/TLS). Casa com `engines`
# (>=22.23.4 <23) e com o CI. A cada security release do Node, subir aqui, em
# `engines`/`volta` e em .github/workflows/build.yml. NAO subir para 23+ sem
# migrar: o Node 26 quebrava @sentry/profiling-node (binding nativo ABI 147
# inexistente) deixando backend/orchestrator em crash-loop.
# nginx vem do apt do Debian bookworm (1.22.1-9+deb12uN): os 5 CVEs de
# out/2026 (alias+rewrite, map+regex, AIO+SSI, HTTP/3, TLS tickets) ainda nao
# tem DSA para bookworm, mas nenhum desses caminhos existe em
# var/docker/nginx.conf — ver docs/planning/upstream-sync-triage-2026-10.md.
FROM node:22.23.4-bookworm-slim
ARG NEXT_PUBLIC_VERSION
ENV NEXT_PUBLIC_VERSION=$NEXT_PUBLIC_VERSION
RUN apt-get update && apt-get install -y --no-install-recommends \
    g++ \
    make \
    python3-pip \
    bash \
    nginx \
&& rm -rf /var/lib/apt/lists/*

RUN addgroup --system www \
 && adduser --system --ingroup www --home /www --shell /usr/sbin/nologin www \
 && mkdir -p /www \
 && chown -R www:www /www /var/lib/nginx


RUN npm --no-update-notifier --no-fund --global install pnpm@10.6.1 pm2@5.4.3

WORKDIR /app

COPY . /app
COPY var/docker/nginx.conf /etc/nginx/nginx.conf

RUN pnpm install --frozen-lockfile
RUN NODE_OPTIONS="--max-old-space-size=4096" pnpm run build

CMD ["sh", "-c", "nginx && pnpm run prisma-db-push && pnpm run pm2"]
